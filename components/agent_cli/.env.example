# Agent CLI env template (copy to .env — do not commit secrets)

DEEPSEEK_API_KEY=your-deepseek-api-key-here
MODEL_NAME=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
MAX_STEPS=10
TOOL_TIMEOUT_SECONDS=60

# Provider-agnostic overrides (win over the DEEPSEEK_* values above).
# Example: point the same agent at a self-hosted vLLM endpoint:
# CITRUS_LLM_PROVIDER=vllm
# CITRUS_LLM_BASE_URL=http://127.0.0.1:8000/v1
# CITRUS_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# CITRUS_LLM_API_KEY=EMPTY
# CITRUS_LLM_TIMEOUT_SECONDS=120
# CITRUS_LLM_MAX_CONCURRENCY=4
# CITRUS_LLM_MAX_TOKENS=1024

# optional HTTP MCP (omit for local stdio)
# MCP_URL=http://127.0.0.1:8080/mcp
# MCP_AUTH_TOKEN=change-me-citrus-mcp

# Webhook server (only for python -m agent_cli.webhook)
# CITRUS_WEBHOOK_TOKEN=change-me-webhook-secret
