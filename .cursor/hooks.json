{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "python .cursor/hooks/record.py",
        "timeout": 15
      }
    ],
    "afterShellExecution": [
      {
        "command": "python .cursor/hooks/record.py",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "python .cursor/hooks/verify_stop.py",
        "timeout": 120,
        "loop_limit": 2
      }
    ]
  }
}
